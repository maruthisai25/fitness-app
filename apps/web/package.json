{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.4-build1",
    "@tanstack/react-query": "5.102.8",
    "@vigor/ai": "workspace:*",
    "@vigor/core": "workspace:*",
    "@vigor/db": "workspace:*",
    "@vigor/library": "workspace:*",
    "@vigor/platform": "workspace:*",
    "@vigor/ui-tokens": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vigor/eslint-config": "workspace:*",
    "@vigor/tsconfig": "workspace:*",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "jsdom": "27.0.0",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.0"
  }
}
