{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vitest/globals"],
    "noEmit": true
  },
  "include": [
    "test/**/*.ts",
    "test/**/*.tsx",
    "test/**/*.cjs",
    "src/**/*.ts",
    "src/**/*.tsx",
    "vitest.config.mts"
  ],
  // The rendering tests run under jest-expo, not vitest: their globals come
  // from `@types/jest` and are checked by `tsconfig.jest.json`. Having both
  // sets of globals in one program would give `expect` two conflicting types.
  "exclude": ["test/**/*.component.test.tsx", "test/jest.setup.ts"]
}
