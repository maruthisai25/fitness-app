{
  "name": "@vigor/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --passWithNoTests",
    "migrations:generate": "drizzle-kit generate",
    "migrations:build": "node ./scripts/build-migrations.mjs",
    "migrations": "pnpm run migrations:generate && pnpm run migrations:build"
  },
  "dependencies": {
    "@vigor/core": "workspace:*",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@vigor/eslint-config": "workspace:*",
    "@vigor/tsconfig": "workspace:*",
    "better-sqlite3": "13.0.3",
    "drizzle-kit": "0.31.10",
    "eslint": "10.10.0",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
