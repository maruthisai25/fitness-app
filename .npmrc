# Expo / Metro cannot follow pnpm's symlinked store layout, so the workspace is hoisted.
node-linker=hoisted

# Expo and React Native ship very wide/loose peer ranges; do not fail installs on them.
strict-peer-dependencies=false
auto-install-peers=true

# Keep lockfile churn deterministic across machines.
prefer-workspace-packages=true
link-workspace-packages=true
